with "config";
with "jsonlib";
with "database";
with "hostkit";
with "cryptolib";

project Quality_Manager is
   Config_Root := external ("CONFIG_ALIRE_PREFIX", "../config");
   Jsonlib_Root := external ("JSONLIB_ALIRE_PREFIX", "../jsonlib");
   Database_Root := external ("DATABASE_ALIRE_PREFIX", "../database");
   Hostkit_Root := external ("HOSTKIT_ALIRE_PREFIX", "../hostkit");
   Representation_Root := external ("REPRESENTATION_ALIRE_PREFIX", "../representation");
   Cryptolib_Root := external ("CRYPTOLIB_ALIRE_PREFIX", "../cryptolib");

   type Boolean_Text is ("false", "true");
   Warnings_As_Errors : Boolean_Text :=
     external ("QUALITY_MANAGER_WARNINGS_AS_ERRORS", "false");
   Coverage : Boolean_Text := external ("QUALITY_MANAGER_COVERAGE", "false");
   Warning_Switches := ();
   Coverage_Switches := ();
   case Warnings_As_Errors is
      when "false" => null;
      when "true"  => Warning_Switches := ("-gnatwe");
   end case;
   case Coverage is
      when "false" => null;
      when "true"  => Coverage_Switches := ("-fprofile-arcs", "-ftest-coverage");
   end case;

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("main.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnata", "-gnatwa", "-gnatVa")
        & Warning_Switches & Coverage_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Builder is
      for Executable ("main.adb") use "quality-manager";
   end Builder;

   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "-u", "quality_manager-journal.adb");
   end Prove;

   package Documentation is
      for Excluded_Project_Files use
        (Config_Root & "/config.gpr", Jsonlib_Root & "/jsonlib.gpr",
         Database_Root & "/database.gpr", Hostkit_Root & "/hostkit.gpr",
         Representation_Root & "/representation.gpr", Cryptolib_Root & "/cryptolib.gpr");
   end Documentation;

   package Linker is
      case Coverage is
         when "false" => null;
         when "true"  =>
            for Default_Switches ("Ada") use ("--coverage");
      end case;
   end Linker;
end Quality_Manager;
