{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-manager.invalid/schemas/approval-decision-v1.schema.json",
  "title": "Quality Manager approval decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision", "approval_id", "quality_database_id",
    "quality_project_id", "canonical_path", "plan_id", "plan_revision",
    "content_sha256", "authorized_action", "policy_sha256", "approver",
    "created_at", "expires_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "decision": { "enum": ["approve", "reject"] },
    "approval_id": { "type": "string", "minLength": 1 },
    "quality_database_id": { "type": "string", "minLength": 1 },
    "quality_project_id": { "type": "integer", "minimum": 1 },
    "canonical_path": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "content_sha256": { "type": "string", "minLength": 1 },
    "authorized_action": { "type": "string", "minLength": 1 },
    "policy_sha256": { "type": "string", "minLength": 1 },
    "approver": { "type": "string", "minLength": 1 },
    "created_at": { "type": "integer", "minimum": 0 },
    "expires_at": { "type": "integer", "minimum": 1 }
  }
}
