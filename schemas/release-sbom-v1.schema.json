{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bracke/quality_manager/schemas/release-sbom-v1.schema.json",
  "title": "Quality Manager CycloneDX release SBOM",
  "type": "object",
  "required": ["bomFormat", "specVersion", "version", "metadata", "components"],
  "properties": {
    "bomFormat": { "const": "CycloneDX" },
    "specVersion": { "const": "1.6" },
    "version": { "const": 1 },
    "metadata": { "type": "object" },
    "components": { "type": "array", "minItems": 1 }
  }
}
