{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-manager.invalid/campaign-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "definition_revision", "projects", "indicators", "target", "work_budget", "priority_rule", "autonomy_policy_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "definition_revision": {"type": "integer", "minimum": 1},
    "projects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["quality_database_id", "project_id", "path", "baseline_assessment"],
      "properties": {
        "quality_database_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1},
        "baseline_assessment": {"type": "integer", "minimum": 1}
      }
    }},
    "indicators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "target": {"enum": ["pass", "pass-or-not-applicable"]},
    "work_budget": {"type": "integer", "minimum": 0},
    "priority_rule": {"type": "string", "minLength": 1},
    "autonomy_policy_digest": {"type": "string", "minLength": 1}
  }
}
