{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quality-manager.invalid/release-evidence-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "release_id", "generation", "project",
    "candidate_commit", "source_fingerprint", "policy_digest", "toolchain_fingerprint",
    "release_config_digest", "assessment_id", "indicator_count", "coverage_basis_points",
    "clean_build", "reproducible_build", "aunit_passed", "gnatprove_passed",
    "release_checks_passed", "improve_audit", "native_audit", "regression_evidence",
    "authorization_audit", "qualification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "release-evidence"},
    "release_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "project": {"type": "object"},
    "candidate_commit": {"type": "string", "minLength": 1},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "minLength": 1},
    "toolchain_fingerprint": {"type": "string", "minLength": 1},
    "release_config_digest": {"type": "string", "minLength": 1},
    "assessment_id": {"type": "integer", "minimum": 1},
    "indicator_count": {"const": 33},
    "coverage_basis_points": {"type": "integer", "minimum": 9000, "maximum": 10000},
    "clean_build": {"const": true},
    "reproducible_build": {"const": true},
    "aunit_passed": {"const": true},
    "gnatprove_passed": {"type": "boolean"},
    "release_checks_passed": {"const": true},
    "improve_audit": {"type": "string"},
    "native_audit": {"type": "string"},
    "regression_evidence": {"type": "string"},
    "authorization_audit": {"type": "string"},
    "qualification": {"const": "qualified"}
  }
}
